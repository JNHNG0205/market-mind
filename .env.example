# Copy to .env and fill in the keys. Dummy values only in this file.
APP_ENV=dev

# Data stores (host values for `make dev`; docker compose overrides them for containers)
DATABASE_URL=postgresql+psycopg://marketmind:marketmind@localhost:5432/marketmind
REDIS_URL=redis://localhost:6379/0
MCP_SERVER_URL=http://localhost:8001/mcp

# LLMs via OpenRouter (see DECISIONS.md D3-D7)
LLM_PROVIDER=openrouter               # openrouter | anthropic | fake
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-dummy
LLM_MODEL_ROUTER=deepseek/deepseek-v4.1-flash-1017
LLM_MODEL_PLANNER=deepseek/deepseek-v4.1-flash-1017
LLM_MODEL_COMPOSER=deepseek/deepseek-v4.1-flash-1017
LLM_FALLBACK_MODEL=z-ai/glm-5.3-flash
OPENROUTER_PROVIDER_ORDER=["Fireworks","Together"]
ANTHROPIC_API_KEY=

# Embeddings (M2, see D8)
EMBEDDING_PROVIDER=openrouter         # openrouter | local
EMBEDDING_MODEL=openai/text-embedding-3-small

# Tools
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-dummy
MARKET_DATA_PROVIDER=exchange         # exchange (Binance) | coingecko
COINGECKO_API_KEY=

# Agent
ROUTER_FAST_PATH_MIN_SIM=0.85
ROUTER_FAST_PATH_MIN_MARGIN=0.10
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=12
